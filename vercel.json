{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/hook.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/h/:id", "destination": "/api/hook?__id=:id" },
    { "source": "/h/:id/:path*", "destination": "/api/hook?__id=:id&__path=:path*" }
  ]
}
